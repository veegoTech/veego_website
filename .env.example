# ============================================================
#  ENVIRONMENT VARIABLES TEMPLATE
#  Copy this file to .env and fill in your actual values.
#  NEVER put real credentials in this file.
# ============================================================

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Node environment (development | production)
NODE_ENV=development

# Google Sheets Webhook Sync for Invoices
VITE_FEE_INVOICE_SHEET_URL=https://script.google.com/macros/s/<apps_script_id>/exec
