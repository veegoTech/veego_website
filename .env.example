# ============================================================
#  ENVIRONMENT VARIABLES TEMPLATE
#  Copy this file to .env and fill in your actual values.
#  NEVER put real credentials in this file.
# ============================================================

# Supabase Project Configuration
VITE_SUPABASE_URL=https://<project_id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your_supabase_anon_key>

# Node environment (development | production)
NODE_ENV=development

# Google Sheets Webhook Sync for Invoices
VITE_FEE_INVOICE_SHEET_URL=https://script.google.com/macros/s/<apps_script_id>/exec

# Razorpay API Credentials
VITE_RAZORPAY_KEY_ID=<your_razorpay_key_id>
RAZORPAY_KEY_SECRET=<your_razorpay_key_secret>

# Mobile SMS Gateway Credentials (Optional for real SMS dispatch to Indian +91 numbers)
FAST2SMS_API_KEY=<your_fast2sms_api_key>
# OR Twilio SMS Gateway:
TWILIO_ACCOUNT_SID=<your_twilio_account_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_PHONE_NUMBER=<your_twilio_phone_number>
